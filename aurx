#!/usr/bin/env python3
import os
import sys
import subprocess
import shutil

AURX_REPO = "https://github.com/OneDevelopmentPL/aurx.git"

def run(cmd):
    result = subprocess.run(cmd, shell=True)
    if result.returncode != 0:
        print(f"[!] Error executing command: {cmd}")
        sys.exit(1)

def install(pkgs):
    for pkg in pkgs:
        print(f"[*] Installing {pkg} from AUR...")
        if os.path.exists(pkg):
            shutil.rmtree(pkg)
        run(f"git clone https://aur.archlinux.org/{pkg}.git")
        os.chdir(pkg)
        run("makepkg -si")
        os.chdir("..")
        shutil.rmtree(pkg)
        print(f"[✓] Package {pkg} installed successfully!")

def remove(pkgs):
    for pkg in pkgs:
        print(f"[*] Removing {pkg}...")
        run(f"sudo pacman -Rns {pkg}")
        print(f"[✓] Package {pkg} removed successfully!")

def update(pkgs):
    for pkg in pkgs:
        if pkg == "me":
            print("[*] Updating aurx itself...")
            if os.path.exists("aurx"):
                shutil.rmtree("aurx")
            run(f"git clone {AURX_REPO} aurx")
            print("[✓] aurx updated successfully!")
        elif pkg == "all":
            print("[*] Updating all AUR packages...")
            print("[!] The 'update all' feature requires a list of installed AUR packages.")
        else:
            print(f"[*] Updating {pkg}...")
            if os.path.exists(pkg):
                shutil.rmtree(pkg)
            run(f"git clone https://aur.archlinux.org/{pkg}.git")
            os.chdir(pkg)
            run("makepkg -si")
            os.chdir("..")
            shutil.rmtree(pkg)
            print(f"[✓] Package {pkg} updated successfully!")

def interactive_menu():
    while True:
        print("\n=== aurx - AUR Manager ===")
        print("1. Install package")
        print("2. Update package")
        print("3. Remove package")
        print("4. Update aurx")
        print("5. Exit")
        choice = input("Select an option: ")
        if choice == "1":
            pkgs = input("Enter package name(s) (separated by space): ").split()
            install(pkgs)
        elif choice == "2":
            pkgs = input("Enter package name(s) (or 'all'/'me'): ").split()
            update(pkgs)
        elif choice == "3":
            pkgs = input("Enter package name(s): ").split()
            remove(pkgs)
        elif choice == "4":
            update(["me"])
        elif choice == "5":
            break
        else:
            print("Invalid choice!")
            
def about():
    print("AUR package manager created by OneDevelopment team! https://github.com/OneDevelopmentPL")

def print_help():
    print("Usage: aurx [operation] [packages]")
    print("\nOperations:")
    print("  -S, inst          Install packages")
    print("  -R, rem           Remove packages")
    print("  -Syu, -Su, update Update packages (use 'me' for aurx, 'all' for everything)")
    print("  x                 Open interactive menu")
    print("  about             Show information about aurx")

def main():
    if len(sys.argv) < 2:
        interactive_menu()
        return

    cmd = sys.argv[1]

    # Mapowanie flag w stylu Arch/pacman oraz starych komend
    if cmd in ["-S", "inst"] and len(sys.argv) >= 3:
        install(sys.argv[2:])
    elif cmd in ["-R", "rem"] and len(sys.argv) >= 3:
        remove(sys.argv[2:])
    elif cmd in ["-Syu", "-Su", "update"] and len(sys.argv) >= 3:
        update(sys.argv[2:])
    elif cmd in ["-Syu", "-Su", "update"] and len(sys.argv) == 2:
        update(["all"])
    elif cmd == "x":
        interactive_menu()
    elif cmd == "about":
        about()
    elif cmd in ["-h", "--help", "help"]:
        print_help()
    else:
        print(f"Unknown operation: {cmd}")
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
